# --- Rust / Cargo ---
target/
src-tauri/target/
**/*.rs.bk
*.pdb

# --- Tauri 2 generated files ---
# Schemas are regenerated on every build. The mobile shells that
# `cargo tauri android init` / `ios init` create (gen/android, gen/apple) ARE
# source: commit them once they exist, but not their build output.
src-tauri/gen/schemas/
src-tauri/gen/android/app/build/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/local.properties
src-tauri/gen/apple/build/
src-tauri/gen/apple/DerivedData/
src-tauri/gen/apple/**/xcuserdata/

# --- Node (not used today, but keep tooling noise out) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Local dev fixtures (generated by dev/make-mock-media.sh; includes a test key.pem) ---
dev/mock-media/
__pycache__/
*.py[cod]

# --- Build outputs, archives, partial downloads ---
dist/
*.zip
*.tar.gz
*.dmg
*.msi
*.AppImage
*.deb
*.rpm
*.part
*.log

# --- Secrets / local config ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# --- Editors ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- OS junk ---
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*
